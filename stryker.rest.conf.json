{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Everything that is not core rules. Mutation gate >= 70% (CLAUDE.md).",
  "packageManager": "npm",
  "testRunner": "command",
  "commandRunner": {
    "command": "node --test test/unit/*.test.js test/api/*.test.js"
  },
  "coverageAnalysis": "off",
  "mutate": [
    "lib/auth.js",
    "lib/coach.js",
    "lib/jobs.js",
    "lib/notify.js",
    "lib/people.js",
    "lib/secsv.js",
    "lib/ical.js",
    "lib/settings.js",
    "lib/sync.js",
    "lib/store.js"
  ],
  "thresholds": { "high": 85, "low": 70, "break": 70 },
  "concurrency": 4,
  "timeoutMS": 60000,
  "tempDirName": ".stryker-tmp-rest",
  "reporters": ["clear-text", "progress"]
}
